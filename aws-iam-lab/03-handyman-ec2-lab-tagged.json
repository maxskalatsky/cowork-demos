{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HandymanStartStopRebootLabTaggedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:*:111122223333:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "aws-iam-lab"
        }
      }
    }
  ]
}
